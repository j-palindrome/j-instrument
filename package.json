{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm launch:max ; pnpm launch:td ; pnpm serve",
    "serve": "tsx src/controls/index.ts",
    "launch:max": "lsof -c Max | grep sound$ || open src/sound/sound.maxproj",
    "launch:td": "lsof -c Touch | grep visuals$ || open src/visuals/visuals.toe",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5",
    "tailwindcss": "^4.0.6"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.55.0",
    "tsx": "^4.19.2",
    "vite": "^5.0.8",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
