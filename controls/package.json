{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm launch:web ; pnpm launch:max ; pnpm launch:td ; pnpm serve",
    "serve": "nodemon --watch src/server src/server/index.ts",
    "launch:web": "lsof -c Google | grep localhost | grep callback || open -na 'Google Chrome' --args --new-window http://localhost:7001",
    "launch:max": "lsof -c Max | grep max-renderer || open ../sound/max-renderer/max-renderer.maxproj",
    "launch:td": "lsof -c Touch | grep touchdesigner-renderer || open ../visuals/touchdesigner-renderer.toe",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@material-tailwind/react": "^2.1.10",
    "address": "^2.0.3",
    "express": "^4.18.2",
    "immer": "^10.0.3",
    "lodash": "^4.17.21",
    "node-osc": "^9.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.1.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.7.3",
    "vite-express": "^0.13.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.14.202",
    "@types/node-osc": "^6.0.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/socket.io": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.11",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
