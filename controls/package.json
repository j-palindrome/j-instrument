{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm launch:max ; pnpm launch:td ; pnpm serve",
    "serve": "tsx src/server/index.ts",
    "launch:max": "lsof -c Max | grep sound$ || open ../sound/sound.maxproj",
    "launch:td": "lsof -c Touch | grep visuals$ || open ../visuals/visuals.toe",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@material-tailwind/react": "^2.1.10",
    "address": "^2.0.3",
    "express": "^4.21.2",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "node-osc": "^9.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "vite-express": "^0.20.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.55.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8"
  }
}
